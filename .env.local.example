# Copy file này thành .env.local rồi điền giá trị thật vào — .env.local không commit lên Git

# Lấy tại Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lấy tại openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=

# Sepay VietQR — lấy tại my.sepay.vn sau khi đã link ngân hàng (Bước 6)
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_API_KEY=

# Mật khẩu trang quản trị /admin — đổi khác "123456" trước khi deploy production
ADMIN_PASSWORD=123456
